# In-process CPU path (default).
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
BACKEND=transformers
QUANTIZATION=int8
MAX_BATCH_SIZE=4
MAX_WAIT_MS=20
MAX_QUEUE_SIZE=64
REQUEST_TIMEOUT_S=180
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
TORCH_THREADS=4
MAX_NEW_TOKENS_CAP=256
ENABLE_ADMIN=false

# Point the gateway at vLLM or SGLang instead of loading weights itself.
# BACKEND=vllm
# UPSTREAM_BASE_URL=http://vllm:8000/v1
# UPSTREAM_API_KEY=EMPTY
# UPSTREAM_MAX_INFLIGHT=16

# BACKEND=llamacpp
# UPSTREAM_BASE_URL=http://llamacpp:8080/v1
# GGUF_PATH=/models/model.gguf
